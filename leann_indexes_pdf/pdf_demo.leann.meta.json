{
  "version": "1.0",
  "backend_name": "hnsw",
  "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
  "dimensions": 384,
  "backend_kwargs": {
    "graph_degree": 32,
    "build_complexity": 64,
    "device": "cpu"
  },
  "embedding_mode": "sentence-transformers",
  "passage_sources": [
    {
      "type": "jsonl",
      "path": "pdf_demo.leann.passages.jsonl",
      "index_path": "pdf_demo.leann.passages.idx",
      "path_relative": "pdf_demo.leann.passages.jsonl",
      "index_path_relative": "pdf_demo.leann.passages.idx"
    }
  ],
  "is_compact": true,
  "is_pruned": true
}